# Obsidian
.obsidian/workspace*
.obsidian/cache/
.obsidian/plugins/
.obsidian/community-plugins.json

# Trash
.trash/
*.tmp

# OS Files
.DS_Store
Thumbs.db

# Personal Content — ignored in this fork
# The update script (cog-update.sh) uses file-by-file extraction, not git merge,
# so there is no risk of merge conflicts with your personal content.
# Users who fork COG to a private repo can freely track their content via git.
#
# This fork is PUBLIC (GitHub cannot make a fork of a public repo private),
# so personal vault content stays local. Framework files already tracked here
# (.gitkeep, 05-knowledge/people/README.md, 06-templates/people-profile-template.md)
# remain tracked; ignore rules only affect new files.
#
00-inbox/*
!00-inbox/.gitkeep
01-daily/*
!01-daily/.gitkeep
02-personal/*
!02-personal/.gitkeep
03-professional/*
!03-professional/.gitkeep
04-projects/*
!04-projects/.gitkeep
05-knowledge/*
!05-knowledge/.gitkeep
06-templates/*
!06-templates/.gitkeep

# IDE
.vscode/
.idea/

# Logs
*.log

# Harness runtime artifacts (written by .claude/lib/checkpoint.sh and /execute)
.claude/logs/
04-projects/harness/runs/

# Backup files
*.bak
*~
*.backup.* # created by cog-update.sh

# Submission and marketplace tracking (keep private)
.github/SUBMISSION-CHECKLIST.md
.github/SUBMISSION-TEMPLATES.md
.github/MARKETPLACE.md
